<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-17">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
	<classpathentry kind="src" output="target/classes" path="src">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry exported="true" kind="lib" path="lib/freemarker.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/openhtmltopdf-core.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/openhtmltopdf-pdfbox.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/pdfbox.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/fontbox.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/xmpbox.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/graphics2d.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/jsoup.jar"/>
	<classpathentry kind="con" path="org.eclipse.m2e.MAVEN2_CLASSPATH_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="target/classes"/>
</classpath>
